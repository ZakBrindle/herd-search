rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Admin & Helper Functions ---
    function adminUids() {
      // Replace with your actual admin UIDs if needed
      return ['bUNLX0K2L7b4pROkz4LR2JUXsjn2', 'z8VvRjk1rmWHKT6nNFCu5eWU12C3'];
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in adminUids() || 
        (request.auth.token.email != null && request.auth.token.email.lower() == 'z4kbrindle@gmail.com')
      );
    }

    function areInSameSquad(userId1, userId2) {
      let user1SquadId = get(/databases/$(database)/documents/users/$(userId1)).data.squadId;
      let user2SquadId = get(/databases/$(database)/documents/users/$(userId2)).data.squadId;
      return user1SquadId != null && user1SquadId == user2SquadId;
    }

    function isMySquadOwner(otherUserId) {
      let mySquadId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.squadId;
      return mySquadId != null && get(/databases/$(database)/documents/squads/$(mySquadId)).data.ownerId == otherUserId;
    }

    // --- Users Collection Rules ---
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        // Allow reading a user's data if they are in the requester's friends list.
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          'friends' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends
        ) ||
        // Allow reading if in the same squad
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.squadId != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.squadId == resource.data.squadId) ||
        isAdmin()
      );
      allow create: if request.auth.uid == userId;
      allow update: if (
        // User can update their own profile fields (location, area, GPS, squad info, friends)
        request.auth.uid == userId && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'location', 'currentArea', 'lastKnownArea', 'useGps', 'lastUpdate',
            'squadId', 'squadOwnerId', 'friends', 'tier', 'subscriptionExpiry','isPaymentPending',
            'statusMessage', 'statusTimestamp', 'ghostMode', 'ghostModeExpiry', 'ghostModeCooldown',
            'fcmToken', 'isDev', 'hasSeenWelcome', 'schedule', 'lastSeenWrapped', 'searchingFor', 'lastRatedWeek',
            'mapPreference', 'hasRated', 'avatarColor', 'avatarEffects', 'useHighQualityImages'
          ])
        )
        // Squad owner can set squadId to null for members
        || (
          resource.data.squadId != null &&
          get(/databases/$(database)/documents/squads/$(resource.data.squadId)).data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['squadId']) &&
          request.resource.data.squadId == null
        )
        // Allow another user to add themselves to my friends list (mutual add)
        || (
          request.auth.uid != userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
          // Modified rule: Checks if 'friends' field exists on target doc, defaulting to empty array logic
          request.resource.data.friends.size() == (resource.data.keys().hasAny(['friends']) ? resource.data.friends.size() : 0) + 1 &&
          request.auth.uid in request.resource.data.friends
        )
      );

      // --- ADDED: Wrapped / Daily Stats ---
      match /dailyStats/{dateStr} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- Purchases Collection Rules ---
    match /purchases/{purchaseId} {
      // Users can see their own purchases (by UID or Email fallback), admins can see all
      allow read, update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        (resource.data.keys().hasAll(['userEmail']) && request.auth.token.email != null && resource.data.userEmail.lower() == request.auth.token.email.lower()) ||
        isAdmin()
      );
      // Users can create their own purchase records
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // --- Stripe Customers Collection Rules (for Firebase Stripe Extension) ---
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }

    // --- Stripe Products Collection Rules (for Firebase Stripe Extension) ---
    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // --- Squads Collection Rules ---
   match /squads/{squadId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        isAdmin() ||
        // Allow reading if you are friends with ANY member of the squad
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          'friends' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends.hasAny(resource.data.members)
        )
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId &&
        request.resource.data.members[0] == request.auth.uid &&
        request.resource.data.members.size() == 1;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid || // Squad owner can update
        isAdmin() || // Admin can update
        // Allow a user to add themselves to the members array when accepting an invite
        // NOTE: This rule is a security compromise if not paired with server-side validation
        // as it allows any authenticated user to add themselves to any squad's members array
        // if it's the only change and they weren't already a member.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.hasAny([request.auth.uid]) &&
          !resource.data.members.hasAny([request.auth.uid])
        )
        // --- ADDED: Allow a user to remove themselves from the members array to leave the squad ---
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.size() == resource.data.members.size() - 1 &&
          resource.data.members.hasAny([request.auth.uid]) &&
          !request.resource.data.members.hasAny([request.auth.uid]) &&
          // Only allow if the user is not the owner (owner must use delete)
          resource.data.ownerId != request.auth.uid
        )
         // --- ADDED: Allow members to vote (update activeVote) ---
        || (
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeVote'])
        )
      );
      allow delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );

      // --- ADDED: Squad Chat Messages ---
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.members ||
          isAdmin()
        );
        allow create: if request.auth != null && (
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.members
        );
      }
    }
    
     // --- Squad Invites Collection Rules ---
    match /squadInvites/{inviteId} {
      // Allow reading if the user is the sender or recipient
      allow read: if request.auth != null && (
        resource.data.from == request.auth.uid ||
        resource.data.to == request.auth.uid
      );
      // Allow creating if the sender is the authenticated user
      allow create: if request.auth != null &&
        request.resource.data.from == request.auth.uid &&
        // Optionally, ensure 'to' is a valid user
        exists(/databases/$(database)/documents/users/$(request.resource.data.to));
      // Optionally, allow update/delete for sender or recipient
      allow update, delete: if request.auth != null && (
        resource.data.from == request.auth.uid ||
        resource.data.to == request.auth.uid
      );
    }

    // --- Areas Collection Rules ---
    match /areas/{areaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // --- Config Collection ---
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // --- Friend Requests Collection Rules ---
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid) ||
        (request.resource.data.to == request.auth.uid || request.resource.data.from == request.auth.uid)
      );
      allow delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // --- Public Profiles (for email lookup) ---
    match /public/user_profiles/users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // --- Support Tickets ---
    match /support_tickets/{ticketId} {
      // Users can see their own tickets, admins can see all
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid in adminUids());
      // Users can create tickets
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Users can update (send msg) their own tickets, Admins can update any
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      // Only admins can delete tickets
      allow delete: if request.auth != null && isAdmin();
    }

    // --- Feedback Collection Rules ---
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // --- Squad Join Requests Collection Rules ---
    match /squadJoinRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    // --- Whats On Feature Rules ---
    match /whats_on_stages/{stageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /whats_on_schedules/{stageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
