{
    "buildCommand": "cd herd-search-vite && npm install && npm run build",
    "outputDirectory": "herd-search-vite/dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}